# Copy to .env in the repository root. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=30

# Dedicated Jarvis MySQL database; fill these only in local .env.
# The database should already exist before running the read-only checker.
JARVIS_DB_HOST=127.0.0.1
JARVIS_DB_PORT=3306
JARVIS_DB_NAME=
JARVIS_DB_USER=
JARVIS_DB_PASSWORD=

# Redis stores account sessions, chat history, PC pairing, and guest quotas.
JARVIS_REDIS_URL=redis://127.0.0.1:6379/0

# Guest model calls: 10 per session. Account and guest calls share one
# in-flight slot and the project daily token/cost reservation ceiling.
DEMO_MAX_CALLS_PER_SESSION=10
DEMO_MAX_CONCURRENT_CALLS=1
DEMO_MAX_DAILY_RESERVED_TOKENS=500000
DEMO_MAX_DAILY_COST_FEN=1000
# Conservative upper price assumption: CNY 100 per 1M input/output tokens.
# Recheck against the configured model's current rates before public release.
DEMO_COST_CEILING_FEN_PER_MILLION_TOKENS=10000
DEMO_MAX_NEW_SESSIONS_PER_IP_HOUR=100
