# Review and adapt paths/user before installing on a Linux server.
# This template is not installed or enabled by the project.
[Unit]
Description=Jarvis API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis/server
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/jarvis/api.env
UMask=0077
ExecStart=/opt/jarvis/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
